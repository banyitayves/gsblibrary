PORT=3001
CLIENT_URL=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USER=library_app
DB_PASSWORD=replace_with_your_mysql_password
DB_NAME=library_management
DB_SSL=false
# Optional TLS certificate for managed database providers. Store the provider's CA certificate here if required.
