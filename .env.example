PORT=3001
CLIENT_URL=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USER=library_app
DB_PASSWORD=replace_with_your_mysql_password
DB_NAME=library_management
DB_SSL=false
# Optional TLS certificate for managed database providers. Store the provider's CA certificate here if required.
# DB_SSL_CA=
MYSQL_ROOT_PASSWORD=replace_with_your_mysql_root_password

# Generate a unique secret with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# Gmail SMTP; enable 2-Step Verification and create a dedicated App Password first.
# Google App Passwords: https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-account@gmail.com
# SMTP_PASSWORD=your-google-app-password
# SMTP_FROM_EMAIL=your-account@gmail.com
# SMTP_FROM_NAME=GS Busanza Library
# OTP_DELIVERY_EMAIL=your-staff-mailbox@gmail.com
# CRON_SECRET=generate_a_long_random_secret_for_overdue_reminders
