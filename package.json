{
  "name": "library-management-system",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev --workspace=backend\" \"npm:dev --workspace=frontend\"",
    "build": "npm run build --workspace=frontend",
    "lint": "npm run lint --workspace=frontend",
    "db:bootstrap": "npm run db:bootstrap --workspace=backend",
    "db:setup": "npm run db:setup --workspace=backend",
    "db:backup": "npm run db:backup --workspace=backend",
    "db:migrate:directory": "npm run db:migrate:directory --workspace=backend",
    "db:update-librarian-login": "npm run db:update-librarian-login --workspace=backend",
    "start": "npm run start --workspace=backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
